{
  "name": "meilleurville",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "search-index": "node scripts/build-search-index.mjs",
    "search-index:check": "node scripts/build-search-index.mjs --check",
    "prebuild": "node scripts/build-search-index.mjs",
    "build": "next build",
    "postbuild": "find out -name '*.txt' ! -name robots.txt -delete 2>/dev/null || true",
    "lint": "eslint",
    "integrity": "node scripts/check-integrity.mjs",
  "hreflang:check": "node scripts/check-hreflang.mjs",
    "parity": "node scripts/check-parity.mjs",
    "build:en": "NEXT_PUBLIC_DEFAULT_LOCALE=en npm run build",
    "cf:dev": "wrangler dev",
    "cf:deploy": "node scripts/check-deploy-locale.mjs fr && wrangler deploy",
    "cf:deploy:en": "node scripts/check-deploy-locale.mjs en && wrangler deploy -c wrangler.en.toml",
    "photos": "node scripts/commune-images.mjs all",
    "photos:update": "node scripts/commune-images.mjs all --update",
    "parks": "node scripts/city-parks.mjs",
    "parks:stats": "node scripts/city-parks.mjs stats",
    "income": "node scripts/city-income.mjs",
    "population": "node scripts/city-population.mjs",
    "biodiversity": "node scripts/city-biodiversity.mjs",
    "biodiversity:stats": "node scripts/city-biodiversity.mjs stats",
    "biodiversity:probe": "node scripts/city-biodiversity.mjs probe",
    "biodiversity:selftest": "node scripts/city-biodiversity.mjs selftest",
    "news": "node scripts/city-news.mjs",
    "news:probe": "node scripts/city-news.mjs probe",
    "news:selftest": "node scripts/city-news.mjs selftest",
    "news:prune": "node scripts/city-news.mjs prune",
    "news:stats": "node scripts/city-news.mjs stats",
    "protected-areas": "node scripts/city-protected-areas.mjs",
    "protected-areas:sources": "node scripts/city-protected-areas.mjs sources",
    "protected-areas:selftest": "node scripts/city-protected-areas.mjs selftest",
    "protected-areas:stats": "node scripts/city-protected-areas.mjs stats"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "wrangler": "^4.86.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
